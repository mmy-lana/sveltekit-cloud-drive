rules_version = '2';

/**
 * Firebase Storage security rules for sveltekit-cloud-drive.
 *
 * Object layout mirrors `DriveFile.storagePath` exactly:
 *
 *   users/{uid}/{itemId}/{fileName}
 *
 * The authorisation rule is a prefix match: the first segment after `users/` is
 * the caller's uid, so a user can only ever address their own subtree. Pinning
 * `{itemId}` as its own segment also means one user cannot address another
 * user's item by crafting a file name that embeds a path.
 *
 * Anything not matched below is denied by default.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Reject empty, over-long, or traversal-shaped path segments. */
    function isSafeSegment(segment) {
      return segment.size() > 0
        && segment.size() <= 256
        && !segment.matches('.*[\\\\/].*');
    }

    /**
     * The `{itemId}` segment is an app-generated UUID.
     *
     * Pinned to the UUID grammar rather than merely "safe": the segment is never
     * user-supplied, so anything that is not a canonical UUID is a path that did
     * not come from `DriveFile.storagePath`, and refusing it keeps a crafted
     * file name from addressing another item's object.
     */
    function isItemId(itemId) {
      return itemId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$');
    }

    /**
     * Writes are bounded at 5 GiB per object and must declare a content type, so
     * a mislabelled upload cannot be persisted as `image/png` for a `.exe` and
     * later be served back to a browser as an image.
     *
     * The ceiling mirrors `MAX_FILE_SIZE_BYTES` in `src/lib/config/constants.ts`.
     * It used to be 5 MiB, which is the documented Storage ceiling for a single
     * *non-resumable* write; this app streams with `uploadBytesResumable`, so the
     * client accepted 5 GiB while the rules refused everything above 5 MiB. The
     * two constants drifting apart is invisible until an upload larger than
     * 5 MiB is reserved against the quota ledger and then rejected at the
     * Storage layer, which orphans the reservation and the blob.
     */
    function isValidUpload(itemId, fileName) {
      return isItemId(itemId)
        && isSafeSegment(fileName)
        && request.resource.size <= 5 * 1024 * 1024 * 1024
        && request.resource.contentType != null;
    }

    match /users/{userId}/{itemId}/{fileName} {
      allow read: if isSelf(userId)
        && isItemId(itemId)
        && isSafeSegment(fileName);

      allow create, update: if isSelf(userId) && isValidUpload(itemId, fileName);

      allow delete: if isSelf(userId)
        && isSafeSegment(itemId)
        && isSafeSegment(fileName);
    }
  }
}
