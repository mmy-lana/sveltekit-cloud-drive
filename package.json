{
  "name": "sveltekit-cloud-drive",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "emulators:up": "docker compose up -d",
    "emulators:logs": "docker compose logs -f firebase-emulator",
    "emulators:down": "docker compose down",
    "emulators:reset": "docker compose down -v",
    "verify": "vite-node --options.deps.inline=@sveltejs scripts/verify-stores.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/vite": "latest",
    "@typescript/native": "npm:typescript@^7.0.2",
    "svelte": "latest",
    "svelte-check": "latest",
    "tailwindcss": "latest",
    "typescript": "~6.0.3",
    "vite": "latest",
    "vite-node": "^6.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.48.0",
    "firebase": "latest"
  }
}
