rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.quota.totalBytes == resource.data.quota.totalBytes
        && request.resource.data.quota.reservedBytes >= 0
        && request.resource.data.quota.usedBytes >= 0
        && (request.resource.data.quota.usedBytes + request.resource.data.quota.reservedBytes) <= resource.data.quota.totalBytes;
      allow delete: if false;
    }

    match /items/{itemId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && (request.resource.data.type == 'file' || request.resource.data.type == 'folder')
        && (request.resource.data.uploadStatus in ['reserved', 'committed']);
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.type == resource.data.type;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
  }
}
